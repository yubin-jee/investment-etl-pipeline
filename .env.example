# Meridian Capital ETL - environment configuration
# Copy this file to ".env" and adjust values. NEVER commit a real .env (it is gitignored).
# These env vars replace the old Windows-specific hardcoded values (C:\MeridianData\, etc.).

# --- Data / output paths (replace the old C:\MeridianData network drive) ---
# Absolute paths, or relative to the repo root. In containers these live on the
# "meridian_data" named volume mounted at /data.
MERIDIAN_DATA_DIR=legacy_data
MERIDIAN_REPORT_DIR=reports
MERIDIAN_LOG_DIR=logs

# Optional: point the scripts at a different config file
# MERIDIAN_CONFIG_FILE=config/batch_config.ini

# --- Timezone (used by the scheduler/cron) ---
TZ=America/New_York

# --- SQL Server 2022 (containerized; replaces SQL Server 2016 / Windows Auth) ---
MSSQL_HOST=sqlserver
MSSQL_PORT=1433
MSSQL_DB=MeridianOMS
MSSQL_USER=sa
# Strong SA password (>= 8 chars, upper/lower/digit/symbol). Placeholder only - set a real one locally.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass
ACCEPT_EULA=Y

# --- SMTP (error notifications) ---
SMTP_HOST=mail.meridian-capital.com
SMTP_PORT=25
SMTP_FROM=batch@meridian-capital.com
SMTP_ERROR_RECIPIENTS=sandra.ops@meridian-capital.com,dave.ops@meridian-capital.com

# --- Schedule (cron expressions; replaces Windows Task Scheduler) ---
SCHEDULE_DAILY_BATCH=30 6 * * 1-5

# --- Tolerances ---
RECON_TOLERANCE_USD=1.00
PRICE_STALE_HOURS=18
MAX_TRADE_ERRORS=50
