# Meridian Capital Partners — Modernized Trade Pipeline Configuration
# Copy to .env and update values for your environment.

# Directory containing daily trade CSVs and counterparty confirm files
TRADE_DIR=./legacy_data/trades/

# Directory for processed output CSVs and reports
OUTPUT_DIR=./reports/

# Database connection string (SQLAlchemy format)
# Examples:
#   SQLite (local dev):   sqlite:///trades.db
#   SQL Server:           mssql+pyodbc://user:pass@server/MeridianOMS?driver=ODBC+Driver+17+for+SQL+Server
#   PostgreSQL:           postgresql://user:pass@host:5432/meridian
DB_CONNECTION_STRING=sqlite:///trades.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
